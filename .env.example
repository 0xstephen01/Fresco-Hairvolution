# Copy this file to `.env` and fill in the two values from your Supabase
# project (Project Settings → API). See BACKEND.md for the full steps.
#
# Without these the site still runs: bookings are kept in the browser and the
# owner area opens with the PIN.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# If you create the project with the Supabase CLI instead of the dashboard,
# `supabase link --project-ref <ref>` and `supabase db push` apply
# supabase/migrations/*.sql for you. That path needs your database password,
# which only you should know, so it is never stored in this project.
